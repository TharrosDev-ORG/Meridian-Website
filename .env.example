# Supabase — public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only (NEVER prefix with NEXT_PUBLIC_)
# Used by utils/supabase/service.ts to bypass RLS for the registerMember server action.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Relevance AI — Tharros FAQ Agent on /qa
# These are PUBLIC because the SDK calls /agents/get_embed_key from the browser
# to mint a scoped, ephemeral embed key for the configured agent.
# REGION accepts "US" / "EU" / "AU" (or the raw region hash). Defaults to US.
NEXT_PUBLIC_RELEVANCE_REGION=US
NEXT_PUBLIC_RELEVANCE_PROJECT=your-relevance-project-id
NEXT_PUBLIC_RELEVANCE_AGENT_ID=your-relevance-agent-id
